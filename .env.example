# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# These are used ONLY by scripts/ running on your machine. The browser app does
# not read them: it resolves its own credentials in src/data/supabase.ts.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API → service_role key.
#
# This key BYPASSES ROW-LEVEL SECURITY ENTIRELY. It can read and delete every
# row in the database, including user profiles. Treat it like a password to the
# whole system:
#   - never paste it into src/, public/, or index.html
#   - never commit it
#   - if it is ever exposed, rotate it in the Supabase dashboard immediately
#
# It is NOT the anon key. The anon key is publishable by design and is already
# in the app; it cannot create users, which is why these scripts need this one.
SUPABASE_SERVICE_ROLE_KEY=


# ─── Build-time, for the browser bundle ─────────────────────────────────────
#
# Vite SUBSTITUTES every VITE_ variable into the JavaScript it ships, so all of
# these are public. Never put a secret behind a VITE_ name — the service-role
# key above must never appear here.
#
# Production sets NONE of them: with all four unset the app resolves the
# hardcoded production project exactly as it always has. They exist so the demo
# deployment can be the same code pointed somewhere else, configured in
# Vercel's environment settings rather than in a branch of the source.

# The demo project's URL and publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 'true' — and only that exact string — turns on demo mode: the permanent
# "everything here is made up" warning above the banner strip.
VITE_DEMO_MODE=

# Hours before a visitor's work is swept, shown in that warning. Must match
# demo_settings.expire_after in the demo database, or the banner promises a
# visitor an evening the database will not give them. Defaults to 48.
VITE_DEMO_EXPIRY_HOURS=
